# ============================================================
# AI Customer Service Platform · 环境变量示例
# 复制本文件为 .env 后按需修改
# ============================================================

# ---- LLM 模型选择 ----
# local      : 本地规则路由 + BM25 RAG（默认，零外部依赖，开箱即用）
# openai     : OpenAI 官方（需海外网络）
# deepseek   : DeepSeek 深度求索（国内）
# qwen       : 通义千问 DashScope 兼容模式（国内）
# zhipu      : 智谱 GLM（国内）
# kimi       : 月之暗面 Moonshot（国内）
MODEL_PROVIDER=local

# ---- 各厂商 API Key（按 MODEL_PROVIDER 选填对应那一个）----
# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
# 通义千问: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
# 智谱: https://open.bigmodel.cn/
ZHIPU_API_KEY=
# Kimi: https://platform.moonshot.cn/
MOONSHOT_API_KEY=
# OpenAI: https://platform.openai.com/（国内需代理）
OPENAI_API_KEY=

# ---- 可选：覆盖默认模型名（一般不用改）----
# CHAT_MODEL=deepseek-chat
# EMBEDDING_MODEL=text-embedding-v3

# ---- 路由模式 ----
# auto  : 有 key 走 LLM tool calling，无 key 走本地规则
# rules : 强制走本地规则（调试用）
AGENT_ROUTER=auto
